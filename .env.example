# Copier vers .env (jamais commité) puis remplacer les valeurs.
# Génération : voir docs/install.md § 2.
# Valeurs vides = démarrage fail-closed : le Vault refuse de démarrer.
HEIMDALL_VAULT_MASTER_KEY=
HEIMDALL_VAULT_API_KEY_PEPPER=
HEIMDALL_VAULT_KEK_SALT=

# UID/GID de l'utilisateur hôte qui possède ./data et ./secrets.
# Renseigner avec `id -u` et `id -g` (ou laisser 1000).
HEIMDALL_UID=1000
HEIMDALL_GID=1000
