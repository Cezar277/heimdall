{
  "name": "heimdall-contract-lint",
  "version": "1.0.0",
  "private": true,
  "description": "Lint OpenAPI du contrat Vault (#15) — version figée via package-lock.json (LOW-4).",
  "scripts": {
    "lint": "spectral lint openapi.yaml --fail-severity warn"
  },
