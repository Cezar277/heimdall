{
  "name": "heimdall-contract-lint",
  "version": "1.0.0",
  "private": true,
  "description": "Lint OpenAPI du contrat Vault (#15) — version figée via package-lock.json (LOW-4).",
  "scripts": {
    "lint": "spectral lint openapi.yaml --fail-severity warn",
    "test:js": "node --test \"tests/js/*.test.js\""
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.17.1",
    "minimatch": "file:./vendor/minimatch-cjs"
  },
  "overrides": {
    "minimatch": "$minimatch",
    "@rollup/plugin-commonjs": "29.0.3"
  },
  "engines": {
    "node": "^22.0 || >=24.0"
  }
}
